#define TRIG_OUT 2 // UNO → Nano trigger 
#define ECHO_IN 3 // UNO ← Nano echo 
const float SOUND_SPEED = 343.0; // m/s 
void setup() { 
Serial.begin(9600); 
Serial.println("UNO Ultrasonic Master"); 
pinMode(TRIG_OUT, OUTPUT); 
pinMode(ECHO_IN, INPUT); 
digitalWrite(TRIG_OUT, LOW); 
} 
void loop() { 
/* ---- Send trigger pulse ---- */ 
digitalWrite(TRIG_OUT, HIGH); 
delayMicroseconds(10); // 10 µs trigger pulse 
digitalWrite(TRIG_OUT, LOW); 
/* ---- Read echo pulse ---- */ 
unsigned long duration = pulseIn(ECHO_IN, HIGH, 30000UL); // timeout 
30 ms 
if (duration == 0) { 
Serial.println("No echo detected"); 
} else { 
/* 
duration is round-trip time in µs 
distance = (time × speed) / 2 
*/ 
float distance_cm = (duration * 0.0343) / 2.0; 
Serial.print("Distance: "); 
Serial.print(distance_cm, 2); 
Serial.println(" cm"); 
} 
delay(200); 
}
